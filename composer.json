{
  "name": "mailkube/mailkube-laravel",
  "description": "Laravel mail transport for mailkube.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mailkube/mailkube-laravel",
  "keywords": ["mailkube", "email", "laravel", "mailer"],
  "require": {
    "php": ">=8.3",
    "composer-runtime-api": "^2.2",
    "mailkube/mailkube-php": "^1.1.0",
    "illuminate/mail": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "symfony/mailer": "^7.0 || ^8.0",
    "symfony/mime": "^7.0 || ^8.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "larastan/larastan": "^3.0",
    "laravel/framework": "^12.61.1 || ^13.12.0",
    "nyholm/psr7": "^1.8",
    "orchestra/testbench": "^10.0 || ^11.0",
    "php-http/mock-client": "^1.6",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.0",
    "slevomat/coding-standard": "^8.15",
    "squizlabs/php_codesniffer": "^3.10 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "Mailkube\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mailkube\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Mailkube\\Laravel\\MailkubeServiceProvider"]
    }
  },
  "scripts": {
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "cs": "phpcs",
    "analyse": "phpstan analyse",
    "mess": "phpmd src text phpmd.xml",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
